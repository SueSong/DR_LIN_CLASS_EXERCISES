  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "24.9.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.17",
    "postcss": "8.4.33",
    "tailwindcss": "3.4.1",
    "typescript": "5.9.3"
  }
}
